{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode gzip

    @auth path /v1/auth/login /v1/auth/register /v1/auth/setup /v1/auth/verify
    rate_limit @auth {
        zone auth_zone {
            key {remote_host}
            events 10
            window 1m
        }
    }

    @api path /v1/* /i /i/*
    rate_limit @api {
        zone api_zone {
            key {remote_host}
            events 100
            window 1m
        }
    }

    handle /v1/* {
        reverse_proxy mint_api:3000
    }

    handle /i {
        reverse_proxy mint_api:3000
    }

    handle /i/* {
        reverse_proxy mint_api:3000
    }

    @assets path *.js *.css *.woff *.woff2 *.ttf *.eot *.ico *.png *.jpg *.jpeg *.gif *.svg *.webp
    handle @assets {
        root * /usr/share/caddy
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
