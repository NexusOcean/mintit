# =============================================================================
# Production Environment (example)
# Copy to .env and place at root, loaded by docker compose.
# Fill in every blank. Generate secrets with: openssl rand -hex 32
# =============================================================================

NODE_ENV=production
ENABLED_CHAINS=                       # comma-separated: xmr, firo, or xmr,firo

# --- Web ---
VITE_API_URL=https://admin.example.com/v1

# --- CORS ---
ALLOWED_ORIGINS=https://admin.example.com   # comma-separated, no trailing slash

# --- Shared auth ---
API_KEY=                              # X-Api-Key, ≥16 chars
# Optional: set only for a controlled demo environment
DEMO_ADMIN_TOTP=
WEBHOOK_SIGNING_SECRET=               # openssl rand -hex 32

# --- Postgres ---
# POSTGRES_USER/PASSWORD/DB provision the bundled mint_db container on first
# boot. DATABASE_URL must use the same values (point at a different host to
# use a self-managed/hosted Postgres instead of mint_db).
POSTGRES_USER=mint
POSTGRES_PASSWORD=                    # openssl rand -hex 24
POSTGRES_DB=mint
DATABASE_URL=postgresql://mint:<POSTGRES_PASSWORD>@mint_db:5432/mint

# --- Monero ---
MONERO_NETWORK=mainnet
MONERO_DAEMON_URI=http://monerod:18081
MONERO_DAEMON_USER=
MONERO_DAEMON_PASSWORD=
MONERO_RPC_LOGIN=                     # user:password (matches DAEMON_USER:DAEMON_PASSWORD)
MONERO_WALLET_PATH=./data/wallet/merchant
MONERO_VIEW_KEY=                      # 64 hex chars (first boot only)
MONERO_PRIMARY_ADDRESS=               # first boot only
MONERO_RESTORE_HEIGHT=                # block height at wallet creation (first boot only)
MONERO_PREWARM_SYNC=false

# --- Firo ---
FIRO_RPC_HOST=firod
FIRO_RPC_PORT=8888
FIRO_RPC_USER=
FIRO_RPC_PASS=
FIRO_RPC_PROTOCOL=http

# --- Optional: CoinMarketCap Pricing ---
CMC_API_KEY=
